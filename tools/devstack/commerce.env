# Commerce against the local stack: Postgres and Keto from compose.yaml, and
# devstack (issuer, checkout, profiles, gateway) on :8090. Commerce itself
# listens on :8081 and is reached through http://localhost:8090/commerce.
SERVICE_NAME=service_commerce
LOG_LEVEL=info
OPENTELEMETRY_DISABLE=true
HTTP_PORT=:8081
PORT=:7081
PROFILER_PORT=
DATABASE_URL=postgres://ant:ant@127.0.0.1:5433/service_commerce?sslmode=disable

OAUTH2_SERVICE_URI=http://localhost:8090
OAUTH2_RESOURCE_AUDIENCE=https://commerce.dev.local
AUTHORIZATION_SERVICE_READ_URI=127.0.0.1:4466
AUTHORIZATION_SERVICE_WRITE_URI=127.0.0.1:4467

CHECKOUT_SERVICE_URI=http://localhost:8090
PROFILE_SERVICE_URI=http://localhost:8090
COMMERCE_SERVICE_URI=http://localhost:8090/commerce
PAYMENT_RETURN_BASE_URL=http://localhost:8090/commerce

# A fixed, public key: fine for local data, never for a deployment.
WEBHOOK_SECRET_KEY=ZGV2LW9ubHktd2ViaG9vay1rZXktMzItYnl0ZXMhISE=
MIGRATION_PATH=./apps/default/migrations/0001

# Commerce's own service account; devstack accepts any credentials.
OAUTH2_SERVICE_CLIENT_ID=service-commerce
OAUTH2_SERVICE_CLIENT_SECRET=dev
OAUTH2_AUDIENCE_BASE_URL=https://dev.local
