{
  "version": "1.0",
  "name": "commerce.reconcile_payments",
  "description": "Every thirty minutes: apply checkout payments buyers completed without returning (whole orders and instalments), release stock from orders whose payment window lapsed, flag or cancel part-paid orders past their balance deadline, and retry undelivered order-event webhooks.",
  "schedules": [
    {
      "name": "commerce.reconcile_payments.every_30m",
      "cron_expr": "*/30 * * * *",
      "timezone": "UTC"
    }
  ],
  "timeout": "10m",
  "on_error": {
    "strategy": "fail"
  },
  "steps": [
    {
      "id": "reconcile",
      "type": "call",
      "name": "Reconcile pending payments",
      "timeout": "5m",
      "retry": {
        "max_attempts": 3,
        "initial_interval": "10s",
        "backoff_coefficient": 2.0,
        "max_interval": "2m"
      },
      "call": {
        "action": "http.request",
        "input": {
          "url": "${COMMERCE_URI}/commerce.v1.CommerceService/ReconcilePayments",
          "method": "POST",
          "headers": {
            "Content-Type": "application/json",
            "Connect-Protocol-Version": "1"
          },
          "body": {
            "limit": 200
          }
        }
      }
    }
  ]
}
